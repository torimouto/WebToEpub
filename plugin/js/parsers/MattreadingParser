"use strict";

parserFactory.register("mattreadingtranslations.com", () => new MattreadingParser());

class MattreadingParser extends Parser {
    constructor() {
        super();
    }
    async getChapterUrls(dom) {
        let menu = dom.querySelector("h2.post-title");
        let chapterUrls = [];
        let links = menu.querySelectorAll("a");
        for (let link of links) {
            if (link.href && link.href.endsWith(".htm")) {
                chapterUrls.push({ 
                    sourceUrl: link.href, 
                    title: link.textContent 
                });
            }
        }
        return chapterUrls;

    findContent(dom) {
        return dom.querySelector("div.entry-content");
    }

    extractTitleImpl(dom) {
        return dom.querySelector("h1.entry-title");
